<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CareOtter Admin"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Panel de administración — IGP v4 TCP :9999"
        android:textSize="11sp"
        android:gravity="center"
        android:textColor="#666"
        android:paddingBottom="8dp" />

    <!-- Auth status -->
    <TextView
        android:id="@+id/tvAuthStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estado: No autenticado"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="8dp"
        android:background="#F0F0F0"
        android:layout_marginBottom="8dp" />

    <!-- IP + Connect -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">
        <EditText
            android:id="@+id/etIpAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="IP (default 192.168.2.1)"
            android:inputType="text" />
        <Button
            android:id="@+id/btnConnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Conectar" />
    </LinearLayout>

    <!-- Module / message field -->
    <EditText
        android:id="@+id/etModuleName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Módulo / mensaje de alerta"
        android:text="CareOtter"
        android:paddingBottom="8dp" />

    <!-- Full flow -->
    <Button
        android:id="@+id/btnCheckStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CHECK STATUS (Flujo completo)"
        android:textStyle="bold"
        android:backgroundTint="#4CAF50"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Comandos individuales:"
        android:textStyle="bold"
        android:textSize="12sp"
        android:paddingBottom="4dp" />

    <!-- Command grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:paddingBottom="8dp">

        <Button android:id="@+id/btnSysInfo"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_columnWeight="1" android:layout_margin="3dp"
            android:text="SYS INFO" android:textSize="11sp" />

        <Button android:id="@+id/btnAuthenticate"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_columnWeight="1" android:layout_margin="3dp"
            android:text="AUTH" android:textSize="11sp" />

        <Button android:id="@+id/btnWifiConfig"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_columnWeight="1" android:layout_margin="3dp"
            android:text="WIFI CONFIG" android:textSize="11sp" />

        <Button android:id="@+id/btnSetTheme"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_columnWeight="1" android:layout_margin="3dp"
            android:text="SET THEME" android:textSize="11sp" />

        <Button android:id="@+id/btnStatus"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_columnWeight="1" android:layout_margin="3dp"
            android:text="STATUS" android:textSize="11sp" />

        <Button android:id="@+id/btnFormatString"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_columnWeight="1" android:layout_margin="3dp"
            android:text="FMT STRING" android:backgroundTint="#FF6B6B"
            android:textSize="11sp" />

        <Button android:id="@+id/btnUnderflow"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_columnWeight="1" android:layout_margin="3dp"
            android:text="UNDERFLOW" android:backgroundTint="#FF6B6B"
            android:textSize="11sp" />

        <Button android:id="@+id/btnDefibrillate"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_columnWeight="1" android:layout_margin="3dp"
            android:text="DEFIBRILLATE" android:backgroundTint="#FF9800"
            android:textSize="11sp" />

        <Button android:id="@+id/btnEmergencyAlert"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_columnWeight="1" android:layout_margin="3dp"
            android:text="EMERGENCY ALERT" android:backgroundTint="#FF9800"
            android:textSize="11sp" />

        <Button android:id="@+id/btnCmdInjection"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_columnWeight="2" android:layout_margin="3dp"
            android:text="CMD INJECTION EXPLOIT" android:backgroundTint="#B71C1C"
            android:textStyle="bold" android:textSize="11sp" />

        <Button android:id="@+id/btnClear"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_columnWeight="2" android:layout_margin="3dp"
            android:text="CLEAR" android:backgroundTint="#6B6B6B"
            android:textSize="11sp" />
    </GridLayout>

    <!-- Output -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Output:" android:textStyle="bold"
        android:paddingTop="4dp" android:paddingBottom="4dp" />

    <ScrollView android:id="@+id/scrollOutput"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="#F0F0F0" android:padding="8dp">
        <TextView android:id="@+id/tvOutput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="10sp" android:text="" />
    </ScrollView>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Rojo oscuro: exploit | Naranja: nuevos comandos | Verde: flujo completo"
        android:textSize="10sp" android:textColor="#666"
        android:gravity="center" android:paddingTop="4dp" />

</LinearLayout>
