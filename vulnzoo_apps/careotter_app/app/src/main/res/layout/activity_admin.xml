<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CareOtter Admin"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#E53935" />

            <Button
                android:id="@+id/btnAdminLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOGOUT"
                android:textSize="10sp"
                android:backgroundTint="#888888" />
        </LinearLayout>

        <!-- Device IP / Port -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etIp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:hint="Device IP"
                android:text="192.168.2.1"
                android:inputType="text"
                android:textSize="12sp"
                android:layout_marginEnd="4dp" />

            <EditText
                android:id="@+id/etPort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Port"
                android:text="9999"
                android:inputType="number"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Module / message input -->
        <EditText
            android:id="@+id/etModuleName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Module name / alert message"
            android:inputType="text"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <!-- Row 1: info commands -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btnSysInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="SYS INFO"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnAuthenticate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="AUTHENTICATE"
                android:backgroundTint="#4CAF50"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnWifiConfig"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WIFI CONFIG"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Row 2: exploit commands -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btnStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="STATUS"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnFormatString"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="FMT STR LEAK"
                android:backgroundTint="#FF9800"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnUnderflow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="UNDERFLOW"
                android:backgroundTint="#FF9800"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Row 3: medical/injection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btnDefibrillate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="DEFIBRILLATE"
                android:backgroundTint="#E53935"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnEmergencyAlert"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="EMERGENCY ALERT"
                android:backgroundTint="#FF9800"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnCmdInjection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CMD INJECTION"
                android:backgroundTint="#9C27B0"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Row 4: check + logs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnCheckStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="CHECK STATUS"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnSetTheme"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SET THEME"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Output -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IGP Output:"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingBottom="4dp" />

        <ScrollView
            android:id="@+id/scrollAdminOutput"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="#F0F0F0"
            android:padding="6dp">
            <TextView
                android:id="@+id/tvAdminOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:text="" />
        </ScrollView>

    </LinearLayout>
</ScrollView>
