#!/bin/sh /etc/rc.common
# Copyright (C) 2025 OpenWrt.org

START=61
STOP=89

USE_PROCD=1

# Detect the correct UART device based on the board
detect_uart_device() {
	# For Pi 3B/3B+, check which UART is connected to Bluetooth
	# Try ttyAMA0 first (standard), then ttyAMA1 (some configurations), then ttyS0 (miniuart)
	if [ -e /dev/ttyAMA0 ]; then
		# Check if we're using miniuart-bt overlay (BT on ttyS0)
		if grep -q "dtoverlay=miniuart-bt" /boot/distroconfig.txt 2>/dev/null || \
		   grep -q "dtoverlay=miniuart-bt" /boot/config.txt 2>/dev/null; then
			echo "/dev/ttyS0"
		else
			# Default: PL011 UART for Bluetooth
			echo "/dev/ttyAMA0"
		fi
	elif [ -e /dev/ttyAMA1 ]; then
		# Alternative UART numbering (common in some device tree configurations)
		echo "/dev/ttyAMA1"
	elif [ -e /dev/ttyS0 ]; then
		echo "/dev/ttyS0"
	else
		return 1
	fi
}

start_service() {
	local uart_device=$(detect_uart_device)

	if [ -z "$uart_device" ]; then
		logger -t brcm-bluetooth "No suitable UART device found for Bluetooth"
		return 1
	fi

	# Check if the device is a Raspberry Pi 3/3B+ with BCM43xx Bluetooth
	if [ ! -f /lib/firmware/brcm/BCM4345C0.hcd ]; then
		logger -t brcm-bluetooth "BCM43xx firmware not found, skipping"
		return 0
	fi

	# Load btbcm module if available and not built-in
	if [ -f /lib/modules/$(uname -r)/btbcm.ko ]; then
		insmod /lib/modules/$(uname -r)/btbcm.ko 2>/dev/null
	fi

	logger -t brcm-bluetooth "Starting Bluetooth on $uart_device"

	procd_open_instance
	procd_set_param command /usr/bin/hciattach -n $uart_device bcm43xx 3000000 flow
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	logger -t brcm-bluetooth "Stopping Bluetooth"
}
