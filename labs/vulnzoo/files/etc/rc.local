#!/bin/sh

# VulnZoo Base System - Startup Script
# Minimal configuration for device profile selection menu

# Start essential VulnZoo services
/etc/init.d/vulnzoo-network enable
/etc/init.d/vulnzoo-network start

/etc/init.d/vulnzoo enable
/etc/init.d/vulnzoo start

/etc/init.d/uhttpd enable
/etc/init.d/uhttpd start

/etc/init.d/snmpd disable 2>/dev/null
/etc/init.d/snmpd stop 2>/dev/null

/etc/init.d/odhcpd disable 2>/dev/null
/etc/init.d/odhcpd stop 2>/dev/null

/etc/init.d/cron disable 2>/dev/null
/etc/init.d/cron stop 2>/dev/null

/etc/init.d/ntpd disable 2>/dev/null
/etc/init.d/ntpd stop 2>/dev/null

/etc/init.d/sysntpd disable 2>/dev/null
/etc/init.d/sysntpd stop 2>/dev/null

/etc/init.d/miniupnpd disable 2>/dev/null
/etc/init.d/miniupnpd stop 2>/dev/null

/etc/init.d/mjpg-streamer disable 2>/dev/null
/etc/init.d/mjpg-streamer stop 2>/dev/null

/etc/init.d/v4l2rtspserver disable 2>/dev/null
/etc/init.d/v4l2rtspserver stop 2>/dev/null

/etc/init.d/radius disable 2>/dev/null
/etc/init.d/radius stop 2>/dev/null

/etc/init.d/motion disable 2>/dev/null
/etc/init.d/motion stop 2>/dev/null

logger -t vulnzoo-base "Lab services disabled for base profile"

# Execute device profile hooks if a device was previously loaded
if [ -x "/usr/lib/vulnzoo-hooks/hook-manager.sh" ]; then
    DEVICE_NAME="$(uci get vulnzoo.state.current_device 2>/dev/null || echo "none")"
    [ "$DEVICE_NAME" != "none" ] && \
        /usr/lib/vulnzoo-hooks/hook-manager.sh init "$DEVICE_NAME"
fi

exit 0
