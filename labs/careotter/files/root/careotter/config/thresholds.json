{
  "description": "CareOtter Cardiac Alert Thresholds (Medical Standards)",
  "version": "1.0",
  "source": "FDA guidelines, ACLS standards",
  "thresholds": {
    "heart_rate": {
      "bradycardia": {
        "max_bpm": 50,
        "severity": "warning",
        "ack_required": false,
        "escalation_seconds": 120
      },
      "tachycardia": {
        "min_bpm": 120,
        "max_bpm": 150,
        "severity": "warning",
        "ack_required": false,
        "escalation_seconds": 60
      },
      "severe_tachycardia": {
        "min_bpm": 150,
        "severity": "critical",
        "ack_required": true,
        "escalation_seconds": 30
      },
      "asystole": {
        "max_bpm": 0,
        "severity": "critical",
        "ack_required": true,
        "escalation_seconds": 10
      }
    },
    "spo2": {
      "hypoxia": {
        "min_spo2": 90,
        "severity": "warning",
        "ack_required": false,
        "escalation_seconds": 30
      },
      "severe_hypoxia": {
        "max_spo2": 85,
        "severity": "critical",
        "ack_required": true,
        "escalation_seconds": 15
      }
    },
    "arrhythmia": {
      "atrial_fibrillation": {
        "hr_variability_threshold": 30,
        "detection_window_seconds": 10,
        "severity": "warning",
        "ack_required": false,
        "escalation_seconds": 60
      },
      "premature_beats": {
        "interval_variance_percent": 25,
        "severity": "info",
        "ack_required": false,
        "escalation_seconds": 120
      }
    },
    "perfusion": {
      "low_perfusion": {
        "max_pi": 1.0,
        "severity": "info",
        "ack_required": false,
        "escalation_seconds": 300
      }
    }
  },
  "physiological_limits": {
    "hr_absolute_min": 0,
    "hr_absolute_max": 220,
    "spo2_absolute_min": 0,
    "spo2_absolute_max": 100,
    "perfusion_index_min": 0.0,
    "perfusion_index_max": 100.0
  },
  "alert_escalation": {
    "enabled": true,
    "max_escalations": 3,
    "escalation_multiplier": 2.0,
    "notify_emergency_services": "critical"
  },
  "data_retention": {
    "readings_retention_days": 30,
    "alerts_retention_days": 90,
    "sync_logs_retention_days": 7
  }
}
