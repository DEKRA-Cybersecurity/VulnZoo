#!/bin/sh /etc/rc.common
#
# CareOtter Admin Service - CareService
# Servicio de administración del dispositivo (puerto 9999)
# Vulnerable a: Format String, Integer Underflow, Hardcoded Token
#

START=70
STOP=10
USE_PROCD=1

PROG=/opt/careotter/careservice
PIDFILE=/var/run/careservice.pid

start_service() {
    # Verificar que el binario existe
    if [ ! -f "$PROG" ]; then
        logger -t careservice "ERROR: Binary not found at $PROG"
        return 1
    fi

    # Verificar que no está ya corriendo
    if [ -f "$PIDFILE" ]; then
        old_pid=$(cat "$PIDFILE" 2>/dev/null)
        if kill -0 "$old_pid" 2>/dev/null; then
            logger -t careservice "Service already running (PID: $old_pid)"
            return 0
        fi
        rm -f "$PIDFILE"
    fi

    logger -t careservice "Starting CareOtter Admin Service on port 9999"
    
    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile "$PIDFILE"
    procd_close_instance
}

stop_service() {
    logger -t careservice "Stopping CareOtter Admin Service"
    if [ -f "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE" 2>/dev/null)
        kill "$pid" 2>/dev/null
        rm -f "$PIDFILE"
    fi
}

reload_service() {
    logger -t careservice "Reloading CareOtter Admin Service"
    stop
    start
}
