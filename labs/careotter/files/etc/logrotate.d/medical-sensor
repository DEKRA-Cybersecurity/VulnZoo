/opt/medical-sensor/vitals.log {
    daily            # rotate daily (alternative: size 1M)
    size 1M          # or when it reaches 1MB
    rotate 5         # keep 5 historical files
    compress         # gzip the rotated files
    delaycompress    # compress on the next rotation
    missingok        # no error if the file is missing
    notifempty       # do not rotate if it is empty
    
    # Notify the service to reopen logs
    postrotate
        # Send SIGUSR1 to the medical sensor process
        killall -SIGUSR1 -f "sensor_service.py" 2>/dev/null || \
        killall -SIGUSR1 python3 2>/dev/null || true
        
        # Log the event
        logger -t logrotate "Medical sensor logs rotated"
    endscript
}
