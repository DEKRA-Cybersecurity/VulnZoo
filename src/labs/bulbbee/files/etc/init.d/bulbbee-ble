#!/bin/sh /etc/rc.common
#
# BulbBee BLE GATT lighting-control server
# BLE peripheral for the Android controller app (BULB-A1)
#

USE_PROCD=1
START=96
STOP=10

PROG=/usr/bin/python3
SCRIPT=/opt/bulbbee/ble_light.py
PIDFILE=/var/run/bulbbee-ble.pid

start_service() {
    if [ ! -f "$SCRIPT" ]; then
        logger -t bulbbee-ble "ERROR: Script not found at $SCRIPT"
        return 1
    fi

    if [ ! -e /sys/class/bluetooth/hci0 ]; then
        logger -t bulbbee-ble "WARNING: Bluetooth adapter not found — service will fail until hci0 appears"
    fi

    logger -t bulbbee-ble "Starting BulbBee BLE GATT server"

    procd_open_instance
    procd_set_param command "$PROG" -u "$SCRIPT"
    procd_set_param env DBUS_SYSTEM_BUS_ADDRESS="${DBUS_SYSTEM_BUS_ADDRESS:-unix:path=/run/dbus/system_bus_socket}"
    procd_set_param env BLE_INTERVAL="${BLE_INTERVAL:-1}"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile "$PIDFILE"
    procd_close_instance
}

stop_service() {
    rm -f "$PIDFILE"
}

reload_service() {
    stop
    start
}
