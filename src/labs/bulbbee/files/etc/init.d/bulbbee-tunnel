#!/bin/sh /etc/rc.common
#
# BulbBee cloud tunnel client (BULB-A3)
# Outbound MQTT tunnel to the cloud emulator broker. Disabled by default:
# enable it (/etc/init.d/bulbbee-tunnel enable && start) once the broker is up
# (cloud_host in /opt/bulbbee/config.json), so procd does not respawn against a
# broker that is not reachable yet.
#

USE_PROCD=1
START=97
STOP=10

PROG=/usr/bin/python3
SCRIPT=/opt/bulbbee/cloud_tunnel.py
PIDFILE=/var/run/bulbbee-tunnel.pid

start_service() {
    if [ ! -f "$SCRIPT" ]; then
        logger -t bulbbee-tunnel "ERROR: Script not found at $SCRIPT"
        return 1
    fi

    logger -t bulbbee-tunnel "Starting BulbBee cloud tunnel client"

    procd_open_instance
    procd_set_param command "$PROG" -u "$SCRIPT"
    procd_set_param respawn 60 10 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile "$PIDFILE"
    procd_close_instance
}

stop_service() {
    rm -f "$PIDFILE"
}
