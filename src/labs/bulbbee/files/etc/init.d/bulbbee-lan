#!/bin/sh /etc/rc.common
#
# BulbBee LAN/TCP local control plane (BULB-A4)
# AES-CCM framed command port on :6668 (Tuya-style local control).
#

USE_PROCD=1
START=97
STOP=10

PROG=/usr/bin/python3
SCRIPT=/opt/bulbbee/local_tcp.py
PIDFILE=/var/run/bulbbee-lan.pid

start_service() {
    if [ ! -f "$SCRIPT" ]; then
        logger -t bulbbee-lan "ERROR: Script not found at $SCRIPT"
        return 1
    fi

    logger -t bulbbee-lan "Starting BulbBee LAN/TCP control plane on :6668"

    procd_open_instance
    procd_set_param command "$PROG" -u "$SCRIPT"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile "$PIDFILE"
    procd_close_instance
}

stop_service() {
    rm -f "$PIDFILE"
}
