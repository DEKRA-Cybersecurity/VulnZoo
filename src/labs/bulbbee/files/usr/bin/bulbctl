#!/bin/sh
#
# bulbctl - local CLI to set the BulbBee WS2812 ring (BULB-A0).
#
# Thin client of the on-device control surface owned by lighting_service. It
# never opens /dev/spidev0.0 directly, since a second SPI writer corrupts the
# WS2812 frame; the daemon stays the single owner of the ring.
#
API="http://127.0.0.1:${BULBBEE_PORT:-8082}"

usage() {
    cat >&2 <<EOF
usage: bulbctl <command>
  color R G B    solid colour, each channel 0-255
  bright N       brightness 0-255
  scene NAME     solid | rainbow | breathe | off
  on | off       power on / off
  state          print the current state
EOF
    exit 1
}

post() { curl -s -X POST "$API$1" -d "$2"; }

case "$1" in
    color)
        [ -n "$4" ] || usage
        post /set "{\"power\":true,\"color\":[$2,$3,$4]}" >/dev/null
        post /scene '{"scene":"solid"}'
        ;;
    bright)
        [ -n "$2" ] || usage
        post /set "{\"brightness\":$2}"
        ;;
    scene)
        [ -n "$2" ] || usage
        post /scene "{\"scene\":\"$2\"}"
        ;;
    on)    post /set '{"power":true}' ;;
    off)   post /scene '{"scene":"off"}' ;;
    state) curl -s "$API/state" ;;
    *)     usage ;;
esac
echo
