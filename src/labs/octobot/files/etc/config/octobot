config octobot 'main'
	option mode 'vulnerable'
	option use_real_hardware '0'
	option serial_port '/dev/ttyUSB0'
	option baud '115200'
	option bus_port '2000'
	option http_port '8090'
	option modbus_port '502'
	option mqtt_host '127.0.0.1'
	option mqtt_topic 'cell01/cmd'
	option api_key 'octobot-industrial-2020'
	option admin_user 'admin'
	option admin_pass 'admin'
	option log_path '/tmp/octobot/operator.log'
