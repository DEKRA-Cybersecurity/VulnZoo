#!/bin/sh /etc/rc.common
# canary BCM - Body Control Module: actuates the central lock from LOCK_CMD.
START=95
STOP=10
USE_PROCD=1

canary_iface() {
	# canary-can resolved the interface at boot and wrote it here (survives the
	# base tarball re-extraction, unlike the UCI use_real_hardware flag).
	cat /tmp/canary/bcm_iface 2>/dev/null || echo vcan0
}

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 /opt/canary/bcm_ecu.py
	procd_set_param env \
		CANARY_IFACE="$(canary_iface)" \
		CANARY_STATE_PATH="$(uci -q get canary.main.state_path)" \
		CANARY_INDICATOR_GPIO="$(uci -q get canary.main.indicator_gpio)"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
