#!/bin/sh /etc/rc.common
# canary CGW - SOME/IP CentralLockingService + CAN gateway (SetLock -> LOCK_CMD),
# plus the exposed management endpoint used by the Jeep kill chain (AUTO-01/05/02).
START=95
STOP=10
USE_PROCD=1

canary_iface() {
	# canary-can resolved the interface at boot and wrote it here (survives the
	# base tarball re-extraction, unlike the UCI use_real_hardware flag).
	cat /tmp/canary/cgw_iface 2>/dev/null || echo vcan0
}

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 /opt/canary/someip_gateway.py
	procd_set_param env \
		CANARY_IFACE="$(canary_iface)" \
		CANARY_SOMEIP_PORT="$(uci -q get canary.main.someip_port)" \
		CANARY_EVENT_TARGET="$(uci -q get canary.main.someip_event_target)" \
		CANARY_MODE="$(uci -q get canary.main.mode)" \
		CANARY_MGMT_PORT="$(uci -q get canary.main.mgmt_port)" \
		CANARY_SETLOCK_TOKEN="$(uci -q get canary.main.setlock_token)" \
		CANARY_FW_KEY="$(uci -q get canary.main.fw_key)" \
		CANARY_SD_ENABLED="$(uci -q get canary.main.sd_enabled)" \
		CANARY_SD_PORT="$(uci -q get canary.main.sd_port)"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
