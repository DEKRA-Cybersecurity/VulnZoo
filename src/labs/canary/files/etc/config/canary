config canary 'main'
	option mode 'vulnerable'
	option use_real_hardware '0'
	option bitrate '500000'
	option oscillator '8000000'
	option cgw_iface 'can0'
	option bcm_iface 'can1'
	option sim_iface 'vcan0'
	option cgw_int '25'
	option bcm_int '24'
	option can_overlay_reboot '1'
	option someip_port '30509'
	option someip_event_target ''
	option indicator_gpio ''
	option state_path '/tmp/canary/lock_state'
