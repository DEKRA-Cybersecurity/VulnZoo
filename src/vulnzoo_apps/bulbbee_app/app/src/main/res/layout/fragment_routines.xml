<?xml version="1.0" encoding="utf-8"?>
<!-- Placeholder. Scheduling has no backing on the device or in the app yet, so
     this destination is honest about being empty rather than faking routines. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="40dp"
    android:background="@color/bb_ground">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.BulbBee.Display"
        android:textSize="22sp"
        android:text="@string/nav_routines" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.BulbBee.Body"
        android:text="@string/routines_empty" />
</LinearLayout>
