<?xml version="1.0" encoding="utf-8"?>
<!-- Login is the start destination (BULB-U1): the mandatory barrier before any
     control. After sign-in MainActivity switches to the Light tab; the four
     bottom-nav tabs share their ids with res/menu/bottom_nav.xml. The old Scan
     entry is retired (BULB-U5): BLE scan is the Light probe (U2) and provisioning
     is the Setup link panel (U4). -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.vulnzoo.bulbbee_app.ui.LoginFragment"
        android:label="@string/cloud_signin_title" />

    <fragment
        android:id="@+id/lightFragment"
        android:name="com.vulnzoo.bulbbee_app.ui.LightFragment"
        android:label="@string/nav_light" />

    <fragment
        android:id="@+id/scenesFragment"
        android:name="com.vulnzoo.bulbbee_app.ui.ScenesFragment"
        android:label="@string/nav_scenes" />

    <fragment
        android:id="@+id/routinesFragment"
        android:name="com.vulnzoo.bulbbee_app.ui.RoutinesFragment"
        android:label="@string/nav_routines" />

    <fragment
        android:id="@+id/setupFragment"
        android:name="com.vulnzoo.bulbbee_app.ui.SetupFragment"
        android:label="@string/nav_setup" />
</navigation>
